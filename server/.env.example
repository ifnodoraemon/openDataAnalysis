# LLM 配置 — 只需选一种格式

# 格式一：OpenAI 格式 (适用于 OpenAI / DeepSeek / 硅基流动 / 任何兼容 OpenAI 的服务)
LLM_PROVIDER=openai
LLM_API_PROTOCOL=responses
LLM_BASE_URL=https://api.openai.com
LLM_API_ENDPOINT=https://api.openai.com/v1/responses
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_HTTP_TIMEOUT_SECONDS=240
LLM_RETRY_BUDGET_SECONDS=360
LLM_DEBUG=false
LLM_DEBUG_DIR=./data/llm-debug

# OpenAI-compatible Chat Completions provider example. Protocol and endpoint are
# explicit; the runtime does not infer either from the hostname or model name.
# LLM_PROVIDER=openai
# LLM_API_PROTOCOL=chat_completions
# LLM_BASE_URL=https://compatible-provider.example
# LLM_API_ENDPOINT=https://compatible-provider.example/v1/chat/completions
# LLM_MODEL=provider-model-id

# 格式二：Anthropic 格式 (适用于 Anthropic / 任何兼容 Anthropic 的服务)
# LLM_PROVIDER=anthropic
# LLM_API_PROTOCOL=messages
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514

# 服务配置
SERVER_PORT=8080
DEPLOYMENT_MODE=development
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
PYTHON_MCP_URL=http://python-executor:8081
PYTHON_MAX_TIMEOUT_SECONDS=120
PROXY_TOKEN=
# Optional public origin for generated Python artifact URLs. Leave empty to use relative /api/python-files/... links.
PUBLIC_API_BASE_URL=
AUTH_SECRET=
# 认证 cookie 是否仅经 HTTPS 发送；纯 HTTP 部署（如本地 compose 的 80 端口）需设为 false，生产必须为 true
AUTH_COOKIE_SECURE=true
# 数据源凭证加密专用密钥；留空时由 AUTH_SECRET 做域分离派生
DATASOURCE_CREDENTIAL_SECRET=
BOOTSTRAP_DEFAULT_IDENTITY=true
# /metrics 默认关闭（404）；nginx/Compose 监控需要时改为 true，并配置 METRICS_AUTH_TOKEN
METRICS_EXPOSE=false
# /metrics 抓取所需的 Bearer token；METRICS_EXPOSE=true 时生产模式必须配置
METRICS_AUTH_TOKEN=
# 反向代理所在网段（CIDR，逗号分隔）；为空时不信任任何代理头，X-Forwarded-For/X-Real-IP 一律忽略。
# compose 部署时网段固定为 172.28.0.0/16（见 docker-compose.yml）
TRUSTED_PROXY_CIDRS=
DEFAULT_USER_ID=example_admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_NAME=Administrator
DEFAULT_USER_PASSWORD=
DEFAULT_WORKSPACE_ID=workspace_default
DEFAULT_WORKSPACE_NAME=Default Workspace
STORAGE_ROOT=./data/storage
CACHE_ROOT=./data/cache
METADATA_DB_PATH=./data/metadata/app.db
TEMP_DIR=./data/tmp

# 本地开发后端。DEPLOYMENT_MODE=production 会拒绝这些单机/本地后端启动。
METADATA_STORE=sqlite
STORAGE_PROVIDER=local
RUN_BACKEND=inprocess
ANALYSIS_STORE=session_sqlite
PYTHON_ARTIFACT_STORE=object_storage

# SQL 数据源 snapshot import 默认行数上限；0 表示不限制。
