# Compose-level environment for docker-compose deployments.
# Copy this file to .env at the repo root before `docker compose up`.

# Shared secret between the backend and the python-executor (required).
# Generate one with: openssl rand -hex 32
PROXY_TOKEN=

# Bearer token required to scrape /metrics (required when METRICS_EXPOSE=true).
# Generate one with: openssl rand -hex 32
METRICS_AUTH_TOKEN=

# Infrastructure credentials. Change these for anything beyond local testing.
POSTGRES_PASSWORD=oda_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Python executor resource limits.
EXECUTOR_MAX_TIMEOUT_SECONDS=120
EXECUTOR_MEMORY_LIMIT_MB=512
