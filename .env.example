# Compose-level environment for docker-compose deployments.
# Copy this file to .env at the repo root before `docker compose up`.

# Shared secret between the backend and the python-executor (required).
# Generate one with: openssl rand -hex 32
PROXY_TOKEN=

# Bearer token required to scrape /metrics (required when METRICS_EXPOSE=true).
# Generate one with: openssl rand -hex 32
METRICS_AUTH_TOKEN=

# Infrastructure credentials. Change these for anything beyond local testing.
POSTGRES_PASSWORD=oda_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Python executor resource limits.
EXECUTOR_MAX_TIMEOUT_SECONDS=120
EXECUTOR_MEMORY_LIMIT_MB=512

# Headless capture service for report views (see docs/report-view-capture.zh-CN.md).
# The asset origin must be reachable from the render-executor container; the
# default works inside docker compose (nginx is on the executor network too).
RENDER_ASSET_BASE_URL=http://client:8080/
# Report view capture switch: off | facts | images.
#   off    - no capture at all (code default)
#   facts  - capture and inject render facts, but no images (benchmarks, cost caps)
#   images - full behaviour: facts plus rendered slices
# Recording benchmark baselines should use off or facts: images add seconds per
# report edit and ~36k tokens per delivery, which silently shifts results.
REPORT_VIEW_CAPTURE=images

# Concurrency and per-capture timeout for the browser service.
RENDER_MAX_CONCURRENT=2
RENDER_CAPTURE_TIMEOUT_MS=8000

# Object storage runs RustFS (S3-compatible). The MINIO_ROOT_* names are kept so
# existing setups keep working; they are mapped to RustFS credentials.
# Set these to something other than the defaults outside local development.
# MinIO images were withdrawn from Docker Hub, which is why the stack no longer
# uses minio/minio.
S3_BUCKET=oda-storage

# Seed a default account on first boot (local development only). Credentials come
# from server/.env (DEFAULT_USER_*).
BOOTSTRAP_DEFAULT_IDENTITY=true
